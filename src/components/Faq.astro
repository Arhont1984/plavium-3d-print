---
interface QA {
  question: string;
  answer: string;
}

interface Props {
  items: QA[];
}

const { items } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((qa) => ({
    "@type": "Question",
    name: qa.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: qa.answer,
    },
  })),
};
---

<div class="faq">
  {items.map((qa) => (
    <details class="faq__item">
      <summary>{qa.question}</summary>
      <p>{qa.answer}</p>
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
    margin: 0 auto;
  }
  .faq__item {
    background: var(--color-white);
    border-radius: 12px;
    padding: 18px 22px;
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 700;
  }
  .faq__item p {
    margin-top: 12px;
    margin-bottom: 0;
    color: var(--color-text-muted);
  }
</style>
